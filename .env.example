# ============================================================
#  本地图片生成器 - 环境配置模板
#  复制为 .env 后按需修改。所有相对路径均相对于项目根目录。
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
# 必须为 1：多 worker 会导致模型被重复加载，显存翻倍
WORKERS=1
RELOAD=false

# ---------- 运行模式 ----------
# mock  = 占位出图（不依赖 torch/模型，用于验证界面与流程）
# comfy = ComfyUI 引擎真实出图（Qwen-Image 2.1 唯一可用通道，推荐）
# local = diffusers 直连（当前与 Qwen-Image 2.1 不兼容，备用）
ENGINE_MODE=mock

# ---------- ComfyUI 引擎（ENGINE_MODE=comfy 时生效）----------
# 首次生成时自动拉起 ComfyUI 子进程，无需手动启动
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_AUTOSTART=true
COMFYUI_DIR=comfyui
COMFYUI_PORT=8188
# 6GB 显存建议保持 --lowvram；显存 12GB 以上可删掉此项换取速度
COMFYUI_EXTRA_ARGS=--lowvram

# ---------- 本地文本模型（漫画工作室 AI 功能）----------
LLM_ENABLED=true
LLM_MAX_LENGTH=768
LLM_TIMEOUT_SECONDS=1800

# ---------- 模型路径（相对项目根目录）----------
MODEL_DIR=models/qwen-image-2.1-unc
TRANSFORMER_FILE=qwen-image-2.1-UC-Q4_K_M.gguf
TEXT_ENCODER_FILE=text_encoders/qwen3vl_8b_int8_convrot.safetensors
VAE_FILE=vae/qwen_image_2.1_vae_bf16.safetensors

# ---------- 设备与精度 ----------
DEVICE=cuda:0
# 省显存关键项：文本编码器放 CPU，可省 9~17 GB 显存
TEXT_ENCODER_DEVICE=cpu
DTYPE=float16
KEEP_LOADED=true
IDLE_UNLOAD_SECONDS=1800
# 大图开启 VAE 分块，防 OOM
VAE_TILING=true
# 低显存模式：显存不足时把部分计算卸载到内存（6GB 及以下显存建议 true）
LOW_VRAM=false

# ---------- 生成默认值 ----------
# 768/8 步为 6GB 显存的实用档；显存充裕可提高到 1024/20
DEFAULT_WIDTH=768
DEFAULT_HEIGHT=768
DEFAULT_STEPS=8
DEFAULT_GUIDANCE=4.0
MAX_BATCH=4
MAX_PIXELS=2073600
# 单张推理总超时；低显存（--lowvram 卸载）下 768/8步 实测约 20 分钟，留足余量
INFER_TIMEOUT_SECONDS=2400
MAX_QUEUE_SIZE=20

# ---------- 存储（全部落在项目根目录下）----------
DATA_DIR=data
OUTPUT_DIR=data/outputs
DB_PATH=data/app.db
MAX_OUTPUT_DIR_GB=50

# ---------- 双通道：在线 API 兜底（可选）----------
ENABLE_REMOTE_FALLBACK=false
REMOTE_PROVIDER=siliconflow
REMOTE_API_KEY=
REMOTE_BASE_URL=https://api.siliconflow.cn/v1
REMOTE_MODEL=Qwen/Qwen-Image-Edit-2509

# ---------- 内容策略（由使用者自行决定）----------
# off = 不处理；flag_only = 仅记录敏感度；block = 命中即拦截
NSFW_FILTER=flag_only
